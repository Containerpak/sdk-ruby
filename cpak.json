{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Ruby SDK",
  "description": "Ruby interpreter, headers, RubyGems and Bundler.",
  "version": "3.3",
  "image": "ghcr.io/containerpak/sdk-ruby@sha256:5896a1073f7941ec63b64229047f41d7447f411c8df47622fcd95ea194ccec4c",
  "binaries": [
    "/usr/bin/ruby",
    "/usr/bin/gem",
    "/usr/bin/bundle",
    "/usr/bin/bundler",
    "/usr/bin/irb"
  ],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [],
  "addon_provider": {
    "id": "ruby",
    "slot": "sdk.ruby",
    "mode": "exclusive",
    "exports": {
      "path": [
        "/usr/bin"
      ]
    }
  },
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": false,
    "socketPulseAudio": false,
    "socketSshAgent": true,
    "socketCups": false,
    "socketGpgAgent": true,
    "bluetooth": false,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "hostApplications": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "hostNetwork": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
